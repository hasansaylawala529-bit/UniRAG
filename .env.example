# Copy this file to .env and put your Gemini key on the first setting line. .env is git-ignored.

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key

# Free-tier setup: Flash-Lite for every step, 3.6 Flash as last-resort backup.
# Check what your key can use with:  python scripts/check_models.py
# GEN_MODEL: SQL generation, rule extraction, synthesis.  FAST_MODEL: routing, relevance grading, HyDE.
GEN_MODEL=gemini-3.1-flash-lite
FAST_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Tried in order if a model is overloaded (503), out of quota (429) or not available to the key (403/404)
GEN_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.6-flash
FAST_MODEL_FALLBACKS=gemini-3.5-flash-lite

# Second provider (optional): used only if every Gemini model in a chain fails. Leave empty to disable.
GROQ_API_KEY=
GROQ_FALLBACK_MODELS=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b

# Requests per minute allowed per model (see https://aistudio.google.com/rate-limit); calls are paced to stay under
MODEL_RPM=gemini-3.1-flash-lite=14,gemini-3.5-flash-lite=14,gemini-3.6-flash=4,gemini-3.8-flash=4,gemini-embedding-001=90

# A model that fails with an overload error (503/504) is skipped for this many seconds (0 disables)
CIRCUIT_BREAKER_SECONDS=60

# Optional: thinking level for Gemini 3 models (e.g. low). Leave empty for the model default.
THINKING_LEVEL=

# Reference date used instead of CURRENT_DATE so answers and evaluation are reproducible
AS_OF_DATE=2026-11-23

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=unirag
POSTGRES_USER=unirag_admin
POSTGRES_PASSWORD=unirag_admin_pw

# Admin connection: used only by ingestion scripts
DATABASE_URL_ADMIN=postgresql://unirag_admin:unirag_admin_pw@localhost:5433/unirag
# Read-only connection: used by the app at question time
DATABASE_URL_READER=postgresql://unirag_reader:unirag_reader_pw@localhost:5433/unirag
